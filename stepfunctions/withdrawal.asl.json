{
  "Comment": "Withdrawal saga. The ledger has already moved the amount to held_cents. Ask the bank, then have the ledger settle (money leaves) or release (money comes back). Terraform fills in the Lambda ARN and queue URL (templatefile).",
  "StartAt": "CallBank",
  "States": {
    "CallBank": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${bank_lambda_arn}",
        "Payload.$": "$"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["com.akshith.payledger.bank.BankUnavailable"],
          "IntervalSeconds": 1,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "Release"
        }
      ],
      "Next": "Settle"
    },
    "Settle": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "Parameters": {
        "QueueUrl": "${queue_url}",
        "MessageBody": {
          "action": "SETTLE",
          "withdrawalId.$": "$.withdrawalId",
          "taskToken.$": "$$.Task.Token"
        }
      },
      "End": true
    },
    "Release": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "Parameters": {
        "QueueUrl": "${queue_url}",
        "MessageBody": {
          "action": "RELEASE",
          "withdrawalId.$": "$.withdrawalId",
          "taskToken.$": "$$.Task.Token"
        }
      },
      "ResultPath": null,
      "Next": "Released"
    },
    "Released": {
      "Type": "Fail",
      "Error": "WithdrawalReleased",
      "Cause": "The bank did not pay out, so the hold was returned to the balance."
    }
  }
}
